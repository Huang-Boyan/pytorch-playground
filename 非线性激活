from torch.nn import ReLU
import torch
from torch import nn

input = torch.tensor([[1,-1],
                      [-2,5]])
input = torch.reshape(input,(-1,1,2,2))

class Mental(nn.Module):
    def __init__(self):
        super(Mental,self).__init__()
        self.relu1 = ReLU()

    def forward(self,input):
        output = self.relu1(input)
        return output

mental = Mental()
output = mental(input)
print(output)
