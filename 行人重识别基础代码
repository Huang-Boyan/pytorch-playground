import os
from PIL import Image
import torch
from torch.utils.data import Dataset, DataLoader
import torchvision.transforms as T


class Market1501(Dataset):
    def __init__(self, root, split='train', transform=None):
        self.root = root
        self.split = split
        self.transform = transform

        if split == 'train':
            self.data_dir = os.path.join(root, 'bounding_box_train')
        elif split == 'test':
            self.data_dir = os.path.join(root, 'bounding_box_test')
        elif split == 'query':
            self.data_dir = os.path.join(root, 'query')

        self.samples = self._load_data()

    def _load_data(self):
        samples = []
        for fname in os.listdir(self.data_dir):
            if fname.endswith('.jpg'):
                pid = int(fname.split('_')[0])
                camid = int(fname.split('_')[1][1])
                img_path = os.path.join(self.data_dir, fname)
                samples.append((img_path, pid, camid))
        return samples

    def __len__(self):
        return len(self.samples)

    def __getitem__(self, idx):
        img_path, pid, camid = self.samples[idx]
        img = Image.open(img_path).convert('RGB')
        if self.transform:
            img = self.transform(img)
        return img, pid, camid


def get_transforms(height=256, width=128, is_train=True):
    normalize = T.Normalize(mean=[0.485, 0.456, 0.406], std=[0.229, 0.224, 0.225])

    if is_train:
        return T.Compose([
            T.Resize((height, width)),
            T.RandomHorizontalFlip(p=0.5),
            T.ToTensor(),
            normalize,
        ])
    else:
        return T.Compose([
            T.Resize((height, width)),
            T.ToTensor(),
            normalize,
        ])

